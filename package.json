{
  "name": "pixel-agents",
  "description": "Pixel art office where AI agents come to life as animated characters. Web-mode shipped under web/ as the npm package pixel-kosmos.",
  "version": "2.0.0-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/june9593/pixel-agents"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:webview": "cd webview-ui && npm run build",
    "test:webview": "cd webview-ui && npm test",
    "lint": "cd webview-ui && eslint .",
    "lint:fix": "cd webview-ui && eslint . --fix",
    "format": "prettier --write \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "format:check": "prettier --check \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "25.x",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "webview-ui/src/**/*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write",
    "webview-ui/**/*.{ts,tsx,js,css,json}": "prettier --write"
  }
}
