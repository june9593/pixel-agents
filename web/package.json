{
  "name": "pixel-kosmos",
  "version": "1.0.0",
  "type": "module",
  "description": "Pixel art office visualization for kosmos-app AI agents",
  "keywords": ["pixel-art", "kosmos", "ai-agents", "visualization"],
  "license": "MIT",
  "bin": {
    "pixel-kosmos": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm run build:webview && npm run build:server && npm run copy-assets",
    "build:webview": "cd ../webview-ui && npx vite build",
    "build:server": "npx tsc -p tsconfig.build.json",
    "copy-assets": "cp -r ../dist/webview dist/webview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "express": "^4.21.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
